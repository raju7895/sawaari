{
  "name": "Sawaari — Auto Booking",
  "short_name": "Sawaari",
  "description": "Book an auto-rickshaw in seconds — real drivers, transparent fares, live tracking.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#0d9488",
  "categories": ["travel", "navigation", "utilities"],
  "lang": "en-IN",
  "dir": "ltr",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Book an auto", "short_name": "Book", "url": "/app/book", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My rides", "short_name": "Rides", "url": "/app/history", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Driver console", "short_name": "Drive", "url": "/driver", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
