# ─────────────────────────────────────────────────────────────────────────────
# SAWAARI — web app (Static Site on Render)
# Copy to web/.env for local development:
#     cd web
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (macOS / Linux)
#
# On Render: set these in the static site's Environment tab. They are read
# at BUILD time — after changing one use "Clear build cache & deploy".
#
# NEVER put the service_role key here. It bypasses every row-level security
# policy and must only ever live in a server environment.
# ─────────────────────────────────────────────────────────────────────────────

# The Supabase project URL — Project Settings → Data API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The anon / publishable key — Project Settings → API Keys → anon public
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Where the Express API still lives. It serves the administrator console
# and the payment gateway until those endpoints are moved to Supabase.
# Leave it empty to use the same origin the page was opened from.
VITE_API_URL=
