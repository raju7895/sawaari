# ─────────────────────────────────────────────────────────────────────────────
# SAWAARI — the web app (a static site on Render)
#
#   cd web
#   cp .env.example .env          (macOS / Linux)
#   copy .env.example .env        (Windows)
#
# On Render: set these in the static site's Environment tab and then use
# "Clear build cache & deploy" — Vite compiles them into the bundle, so a
# cached build keeps the old values.
#
# NEVER put the Supabase service_role / secret key here. It bypasses every
# row-level security policy and must only ever live in a server environment.
# ─────────────────────────────────────────────────────────────────────────────

# The Supabase project URL — Project Settings → Data API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The anon / publishable key — Project Settings → API Keys
# (public by design: every table is protected by row-level security)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ─────────────────────────────────────────────────────────────────────────────
# The optional ways of getting in. Both are OFF unless the thing they
# need is really there — a button that cannot work is worse than none.
#
# VITE_ENABLE_PHONE_OTP=true
#     only after a phone provider (Twilio Verify & co.) is set up in
#     Supabase → Authentication → Sign In / Providers → Phone. Until then
#     the Auth service answers every phone request with
#     "Unsupported phone provider".
#
# VITE_ENABLE_EMAIL_OTP=true
#     only after a working SMTP provider is set up (Supabase →
#     Authentication → Email → SMTP Settings) and the e-mail templates
#     carry the code ({{ .Token }}).
#
# E-mail and password always work — they need nothing but the project.
# ─────────────────────────────────────────────────────────────────────────────
VITE_ENABLE_PHONE_OTP=false
VITE_ENABLE_EMAIL_OTP=false
