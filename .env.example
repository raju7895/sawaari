# ─────────────────────────────────────────────────────────────────────────────
# SAWAARI — the whole project (one file for local development)
#
#   cp .env.example .env          (macOS / Linux)
#   copy .env.example .env        (Windows)
#
# The web app is a static site; the whole backend is Supabase (Auth,
# Postgres with row-level security, Storage and Realtime). There is no
# server process any more, so there is no server/.env.
#
# NEVER commit a real .env — it is git-ignored.
# NEVER put the Supabase service_role / secret key in the web app.
# ─────────────────────────────────────────────────────────────────────────────

# ── the web app (Vite) ─────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
