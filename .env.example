# ─────────────────────────────────────────────────────────────────────────────
# SAWAARI — the whole project (one file for local development)
#
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS / Linux)
#
# The API reads its own copy from server/.env — see server/.env.example
# for the full list of server variables. This file covers the web app.
#
# NEVER commit a real .env — it is git-ignored.
# NEVER put the Supabase service_role key in the web app.
# ─────────────────────────────────────────────────────────────────────────────

# ── the web app (Vite) ─────────────────────────────────────────────────────
# Supabase project URL and the anon / publishable key.
# Both are safe to expose in the browser: every table is protected by
# row-level security, and the anon key can only read what the signed-in
# user is allowed to read.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Where the Express API still runs (administrator console + payment
# gateway). Leave empty for the same origin.
VITE_API_URL=http://localhost:4000
