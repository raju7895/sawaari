# ──────────────────────────────────────────────────────────────
# SAWAARI SERVER CONFIGURATION — copy to .env and fill in values.
# Services without credentials degrade gracefully (see README).
# ──────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development
# Public URL of the web app (used in share links / emails)
APP_URL=http://localhost:5173

# ── DATABASE ──────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sawaari

# ── SECURITY ──────────────────────────────────────────────────
# REQUIRED: change this to a long random string (openssl rand -hex 32)
JWT_SECRET=
# OTP hashing pepper (openssl rand -hex 24)
OTP_PEPPER=

# Admin bootstrap account (created by `npm run seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=            # leave blank -> npm run seed generates one
ADMIN_PHONE=9999999999

# ── PLATFORM OWNER (SUPER_ADMIN) ────────────────────────────
# Created by `npm run seed:superadmin`. The password is a deployment
# secret: set it here or in your secret manager. If it is empty the
# seed script generates a strong one-time password and writes it to
# server/backups/superadmin-credentials.txt (git-ignored).
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Platform Owner
SUPER_ADMIN_PHONE=

# Encrypts the TOTP shared secrets at rest (falls back to JWT_SECRET)
ADMIN_TOTP_ENCRYPTION_KEY=

# Administrator security policy
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15
ADMIN_MAX_FAILED_ATTEMPTS=5
ADMIN_ACCOUNT_LOCK_MINUTES=30
ADMIN_SESSION_HOURS=12
ADMIN_INVITE_EXPIRY_HOURS=72
# Request-rate limits per source address (raise only in a test environment)
ADMIN_LOGIN_RATE_LIMIT=20
ADMIN_2FA_RATE_LIMIT=30

# ── OTP / SMS ─────────────────────────────────────────────────
# true = OTP is returned in API responses + server logs (development only)
SMS_DEV_MODE=true
# Provider: none | msg91 | twilio
SMS_PROVIDER=none
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SAWAAR
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── EMAIL (nodemailer SMTP) ───────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sawaari <no-reply@sawaari.local>

# ── PAYMENTS: RAZORPAY ────────────────────────────────────────
# Leave empty to disable online payments (UPI-QR/cash still work)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── WEB PUSH NOTIFICATIONS ────────────────────────────────────
# Generate once: npm run generate:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── MAPS / ROUTING ────────────────────────────────────────────
OSRM_BASE_URL=https://router.project-osrm.org
# Extra routing hosts tried in order if the primary is unreachable
OSRM_FALLBACK_URLS=https://routing.openstreetmap.de/routed-car
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ── RUNTIME TUNING ────────────────────────────────────────────
UPLOAD_DIR=uploads
