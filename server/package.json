{
    "name":  "sawaari-server",
    "version":  "1.0.0",
    "private":  true,
    "description":  "Sawaari - local auto-rickshaw booking platform API",
    "main":  "src/index.js",
    "scripts":  {
                    "start":  "node src/index.js",
                    "dev":  "node --watch src/index.js",
                    "migrate":  "node src/migrate.js",
                    "seed":  "node src/seed.js",
                    "setup":  "node src/migrate.js \u0026\u0026 node src/seed.js",
                    "seed:superadmin":  "node src/scripts/seed-superadmin.js",
                    "admin:password":  "node src/scripts/set-admin-password.js",
                    "admin:diagnose":  "node src/scripts/diagnose-admin-login.js",
                    "admin:verify":  "node src/scripts/verify-owner-password.js",
                    "sweep:api":  "node src/scripts/sweep-admin-api.js",
                    "sweep:web":  "node src/scripts/sweep-frontend.js",
                    "db:backup":  "node src/scripts/db-backup.js",
                    "db:integrity":  "node src/scripts/db-integrity.js",
                    "generate:vapid":  "node src/scripts/generate-vapid.js",
                    "audit:push":  "node ../scripts/audit-before-push.js"
                },
    "dependencies":  {
                         "bcryptjs":  "^2.4.3",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.5",
                         "express":  "^4.19.2",
                         "express-rate-limit":  "^7.4.0",
                         "jsonwebtoken":  "^9.0.2",
                         "multer":  "^2.5.0",
                         "nodemailer":  "^6.9.14",
                         "pg":  "^8.12.0",
                         "qrcode":  "^1.5.4",
                         "socket.io":  "^4.7.5",
                         "web-push":  "^3.6.7",
                         "zod":  "^3.23.8"
                     }
}
